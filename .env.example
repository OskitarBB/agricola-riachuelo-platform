# .env.example — Copia este archivo como .env (scripts/iniciar.ps1 lo hace solo y genera la clave secreta).
# Nunca subas el .env a Git: contiene secretos. En el servidor del piloto estas variables van en el panel del hosting.

# ------------------------------------------------------------------ entorno
# dev    → tu computadora: Cloudinary simulado si no hay CLOUDINARY_URL, detector de IA simulado, WhatsApp en consola.
# piloto → servidor real: exige HTTPS, Cloudinary, PostgreSQL (Supabase) y prohíbe los datos de demostración.
APP_ENV=dev
DJANGO_DEBUG=true
# Clave larga y aleatoria (mínimo 50 caracteres). Generar: python -c "import secrets; print(secrets.token_urlsafe(60))"
DJANGO_SECRET_KEY=
# En dev se aceptan todos los hosts (el celular llega por la IP de la laptop). En piloto: tu dominio.
# ALLOWED_HOSTS=monitoreo.tudominio.pe
# CSRF_TRUSTED_ORIGINS=https://monitoreo.tudominio.pe
# Dirección pública de la web: va en el enlace del aviso de WhatsApp (https:// en piloto).
PUBLIC_BASE_URL=http://localhost:8000

# ------------------------------------------------------------------ base de datos
# Vacío en dev → SQLite (archivo db.sqlite3, sin instalar nada).
# Supabase (recomendado también en dev para probar como en el piloto): botón «Connect» → «Direct» →
# «Session pooler» (puerto 5432, NO el transaction pooler 6543). Ver docs/ARQUITECTURA_DATOS.md §7. Ejemplo:
# DATABASE_URL=postgres://postgres.<ref>:<contraseña>@aws-0-<region>.pooler.supabase.com:5432/postgres
DATABASE_URL=
# require para Supabase; disable para un PostgreSQL local sin TLS.
DB_SSLMODE=require
# DB_CONN_MAX_AGE=60
# Tamaño del plan para el aviso de espacio de `diagnostico` (Supabase Free 500 MB; Pro 8192).
DB_LIMITE_MB=500

# ------------------------------------------------------------------ fotos (Cloudinary)
# Vacío en dev → «Cloudinary simulado» en esta computadora (las fotos de la app quedan en media/).
# Real: Cloudinary → Settings → API Keys → «API environment variable». Crear además dos transformaciones con nombre:
#   miniatura = c_limit,w_400,q_auto     revision = c_limit,w_1600,q_auto
# CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>
CLOUDINARY_URL=
# Carpeta raíz: riachuelo/<prefijo>/<sesión>/<pasada>/<captura>
CLOUDINARY_ENV_PREFIX=dev
# CLOUDINARY_MAX_UPLOAD_BYTES=10485760

# ------------------------------------------------------------------ avisos por WhatsApp (Cloud API de Meta)
# ConsoleClient: el worker imprime el aviso en su terminal (no envía). CloudApiClient: envío real.
WHATSAPP_CLIENT=notificaciones.whatsapp.ConsoleClient
# WHATSAPP_CLIENT=notificaciones.whatsapp.CloudApiClient
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
# Versión vigente de la Graph API indicada por Meta (por ejemplo v23.0).
WHATSAPP_GRAPH_VERSION=
# Plantilla aprobada en Meta (6 parámetros: lote, hilera, lateral, ubicación, decisión, enlace).
WHATSAPP_TEMPLATE=caso_confirmado
# v1.3: plantilla para las alertas confirmadas por la IA (vacía = la misma de arriba)
WHATSAPP_TEMPLATE_IA=
WHATSAPP_TEMPLATE_LANG=es

# ------------------------------------------------------------------ IA (worker_ia)
# simulado → cajas de prueba (solo dev). onnx → modelo YOLO exportado a ONNX (pip install -r requirements-ia.txt).
IA_DETECTOR=simulado
# Ruta al modelo exportado: yolo export model=best.pt format=onnx imgsz=640
# MODEL_PATH=ia/inference/weights/modelo.onnx
# Solo con el detector simulado: fracción de fotos con indicio (0.2 = 20 %).
IA_SIMULADO_PROBABILIDAD=0.2
# IA_DESCARGA_TIMEOUT=60

# ------------------------------------------------------------------ consola y web
# Una línea por petición (con traceId) y aviso de las lentas.
LOG_LEVEL=INFO
LOG_REQUESTS=true
LOG_SLOW_MS=1500
# LOG_COLOR=0   # desactiva los colores si tu consola no los muestra
# Segundos entre actualizaciones automáticas de la bandeja y de la actividad en vivo.
WEB_BANDEJA_POLL_SECONDS=15
WEB_ACTIVIDAD_POLL_SECONDS=20
# SESSION_COOKIE_AGE=28800
