# Django
DJANGO_SECRET_KEY=cambia-esto-por-una-clave-larga-y-aleatoria
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
PUBLIC_BASE_URL=http://localhost:8000

# Supabase/PostgreSQL. Use the direct or session-pooler URL from Supabase.
DATABASE_URL=postgres://postgres:password@db.proyecto.supabase.co:5432/postgres

# Cloudinary. The browser never receives this secret; Django signs URLs.
CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>
CLOUDINARY_ENV_PREFIX=dev

# WhatsApp Cloud API. The worker reads these; requests web do not call WhatsApp.
WHATSAPP_CLIENT=notificaciones.whatsapp.ConsoleClient
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_GRAPH_VERSION=v99.0
WHATSAPP_TEMPLATE=caso_confirmado
WHATSAPP_TEMPLATE_LANG=es

# Local development keeps collectstatic simple.
STATICFILES_BACKEND=django.contrib.staticfiles.storage.StaticFilesStorage
