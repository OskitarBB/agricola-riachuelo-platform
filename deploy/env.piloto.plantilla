# deploy/env.piloto.plantilla — instalar.sh la copia a deploy/.env.piloto (secretos del VPS, permisos 600). Nunca a Git ni al chat.
# Editar:  nano /srv/riachuelo/deploy/.env.piloto      Aplicar cambios:  bash /srv/riachuelo/deploy/actualizar.sh

# ------------------------------------------------------------------ entorno (no cambiar)
APP_ENV=piloto
DJANGO_DEBUG=false
# La genera instalar.sh la primera vez.
DJANGO_SECRET_KEY=
ALLOWED_HOSTS=monitoreo.agricolariachuelo.org
CSRF_TRUSTED_ORIGINS=https://monitoreo.agricolariachuelo.org
PUBLIC_BASE_URL=https://monitoreo.agricolariachuelo.org

# ------------------------------------------------------------------ base de datos (Supabase del PILOTO)
# Proyecto nuevo en São Paulo (sa-east-1), sin datos de demostración. Connect → Direct → Session pooler (5432).
# Contraseña solo con letras y números. Formato:
# DATABASE_URL=postgresql://postgres.<ref>:<contraseña>@aws-0-sa-east-1.pooler.supabase.com:5432/postgres
DATABASE_URL=
DB_SSLMODE=require
DB_LIMITE_MB=500

# ------------------------------------------------------------------ fotos (Cloudinary)
# Settings → API Keys → «API environment variable». Transformaciones con nombre: miniatura y revision.
# CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>
CLOUDINARY_URL=
CLOUDINARY_ENV_PREFIX=piloto
API_SUBIDA_MULTIPART=true

# ------------------------------------------------------------------ IA (pendiente: modelo YOLO)
# Sin el archivo modelos/modelo.onnx el worker NO inventa resultados: las fotos quedan «en cola» y se analizan
# solas cuando se copie el modelo (deploy/LEEME.md, «Cuando llegue el modelo YOLO»).
IA_DETECTOR=onnx
MODEL_PATH=modelos/modelo.onnx

# ------------------------------------------------------------------ WhatsApp (pendiente)
# Mientras tanto los avisos se escriben en el log del worker (docker compose logs worker).
WHATSAPP_CLIENT=notificaciones.whatsapp.ConsoleClient
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_GRAPH_VERSION=
WHATSAPP_TEMPLATE=caso_confirmado
WHATSAPP_TEMPLATE_IA=
WHATSAPP_TEMPLATE_LANG=es

# ------------------------------------------------------------------ consola
LOG_LEVEL=INFO
LOG_REQUESTS=true
LOG_SLOW_MS=1500
LOG_COLOR=0
